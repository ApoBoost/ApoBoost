{
  "name": "apoboost",
  "version": "1.0.4",
  "private": true,
  "description": "【フォーム＆メール】ApoBoost — 問い合わせフォーム／メール営業の自動送信ツール（単体版）",
  "type": "module",
  "scripts": {
    "start": "node scripts/run.mjs",
    "dev": "tsx src/server.ts",
    "worker": "tsx src/worker.ts",
    "cli": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx test/unit.ts && tsx test/replies.ts && tsx test/smoke.ts && tsx test/todo.ts && tsx test/e2e.ts",
    "release": "node scripts/release.mjs",
    "license": "node scripts/license.mjs",
    "test:quick": "tsc --noEmit && tsx test/unit.ts && tsx test/replies.ts && tsx test/smoke.ts"
  },
  "dependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/nodemailer": "^8.0.1",
    "adm-zip": "^0.6.0",
    "better-sqlite3": "^12.11.1",
    "csv-parse": "^5.6.0",
    "express": "^4.21.2",
    "imapflow": "^2.0.5",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^10.0.0",
    "playwright": "^1.49.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
